<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Lets `dotnet user-secrets` keep the dev signing key and bootstrap password off disk in the repo. -->
    <UserSecretsId>nenep-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NeNep.Infrastructure\NeNep.Infrastructure.csproj" />
    <ProjectReference Include="..\NeNep.Scoring\NeNep.Scoring.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
